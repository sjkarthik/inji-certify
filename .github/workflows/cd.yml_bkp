name: Inji Certify CD

on:
  push:
    branches:
      - CD-Pipeline

  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: inji-certify-rke2-deployment
  cancel-in-progress: false

jobs:

  # ----------------------------------------
  # JOB 1: BUILD AND PUSH DOCKER IMAGES
  # ----------------------------------------

  docker-build-push:
    name: Build and Push Docker Images
    runs-on: ubuntu-latest

    if: >
      github.event.workflow_run.conclusion == 'success' &&
      github.event.workflow_run.head_repository.full_name == github.repository

    outputs:
      image_tag: ${{ github.event.workflow_run.head_sha }}

    steps:

      - name: Checkout successful CI commit
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.workflow_run.head_sha }}

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: maven

      - name: Build Maven packages
        run: |
          chmod +x mvnw
          ./mvnw -DskipTests package

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      # Build base Inji Certify image
      - name: Build and Push Inji Certify Image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: certify-service/Dockerfile
          push: true
          tags: |
            sjkarthik/inji-certify:${{ github.event.workflow_run.head_sha }}
            sjkarthik/inji-certify:CD-Pipeline

      # Build plugins image
      - name: Build and Push Inji Certify Plugins Image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: certify-service-with-plugins/Dockerfile
          push: true
          tags: |
            sjkarthik/inji-certify-with-plugins:${{ github.event.workflow_run.head_sha }}
            sjkarthik/inji-certify-with-plugins:CD-Pipeline

  # ----------------------------------------
  # JOB 2: DEPLOY TO EXISTING RKE2 CLUSTER
  # ----------------------------------------

  deploy-to-rke2:
    name: Deploy Inji Certify to RKE2
    runs-on: [self-hosted, linux, rke2-deploy]

    needs: docker-build-push

    environment: inji-certify-dev

    timeout-minutes: 20

    env:
      NAMESPACE: inji-certify
      DEPLOYMENT_NAME: inji-certify
      CONTAINER_NAME: inji-certify
      IMAGE_REPOSITORY: sjkarthik/inji-certify-with-plugins
      IMAGE_TAG: ${{ needs.docker-build-push.outputs.image_tag }}

    steps:

      - name: Configure RKE2 kubeconfig
        shell: bash
        env:
          RKE2_KUBECONFIG: ${{ secrets.RKE2_KUBECONFIG }}
        run: |
          set -euo pipefail

          mkdir -p "$RUNNER_TEMP/kube"
          chmod 700 "$RUNNER_TEMP/kube"

          export KUBECONFIG="$RUNNER_TEMP/kube/config"

          printf '%s' "$RKE2_KUBECONFIG" > "$KUBECONFIG"
          chmod 600 "$KUBECONFIG"

          echo "KUBECONFIG=$KUBECONFIG" >> "$GITHUB_ENV"

      - name: Verify RKE2 connectivity
        run: |
          kubectl cluster-info
          kubectl get nodes

      - name: Verify existing Inji Certify deployment
        run: |
          set -euo pipefail

          kubectl get deployment "$DEPLOYMENT_NAME" \
            -n "$NAMESPACE"

          echo "Current container configuration:"
          kubectl get deployment "$DEPLOYMENT_NAME" \
            -n "$NAMESPACE" \
            -o jsonpath='{range .spec.template.spec.containers[*]}{.name}{" | "}{.image}{"\n"}{end}'

          ACTUAL_CONTAINER=$(kubectl get deployment "$DEPLOYMENT_NAME" \
            -n "$NAMESPACE" \
            -o jsonpath='{.spec.template.spec.containers[0].name}')

          if [ "$ACTUAL_CONTAINER" != "$CONTAINER_NAME" ]; then
            echo "ERROR: Container name mismatch."
            echo "Expected: $CONTAINER_NAME"
            echo "Found: $ACTUAL_CONTAINER"
            exit 1
          fi

      - name: Update Inji Certify Docker image
        id: deploy
        run: |
          set -euo pipefail

          NEW_IMAGE="${IMAGE_REPOSITORY}:${IMAGE_TAG}"

          PREVIOUS_IMAGE=$(kubectl get deployment "$DEPLOYMENT_NAME" \
            -n "$NAMESPACE" \
            -o jsonpath='{.spec.template.spec.containers[0].image}')

          echo "Previous image: $PREVIOUS_IMAGE"
          echo "New image: $NEW_IMAGE"

          echo "previous_image=$PREVIOUS_IMAGE" >> "$GITHUB_OUTPUT"

          kubectl set image deployment/"$DEPLOYMENT_NAME" \
            "$CONTAINER_NAME=$NEW_IMAGE" \
            -n "$NAMESPACE"

      - name: Verify deployment rollout
        id: rollout
        continue-on-error: true
        run: |
          kubectl rollout status deployment/"$DEPLOYMENT_NAME" \
            -n "$NAMESPACE" \
            --timeout=600s

      - name: Roll back if deployment fails
        if: steps.rollout.outcome == 'failure'
        run: |
          set -euo pipefail

          PREVIOUS_IMAGE="${{ steps.deploy.outputs.previous_image }}"

          echo "Deployment failed. Restoring previous image:"
          echo "$PREVIOUS_IMAGE"

          kubectl set image deployment/"$DEPLOYMENT_NAME" \
            "$CONTAINER_NAME=$PREVIOUS_IMAGE" \
            -n "$NAMESPACE"

          kubectl rollout status deployment/"$DEPLOYMENT_NAME" \
            -n "$NAMESPACE" \
            --timeout=600s

          exit 1

      - name: Verify deployed image and pods
        if: steps.rollout.outcome == 'success'
        run: |
          echo "Deployment successful."

          kubectl get deployment "$DEPLOYMENT_NAME" \
            -n "$NAMESPACE" \
            -o jsonpath='{.spec.template.spec.containers[*].image}{"\n"}'

          kubectl get pods -n "$NAMESPACE" -o wide

          kubectl get deployment "$DEPLOYMENT_NAME" \
            -n "$NAMESPACE"

      - name: Collect deployment diagnostics
        if: failure()
        run: |
          echo "Deployment diagnostics"

          kubectl get pods -n "$NAMESPACE" -o wide || true

          kubectl describe deployment "$DEPLOYMENT_NAME" \
            -n "$NAMESPACE" || true

          kubectl get events -n "$NAMESPACE" \
            --sort-by='.lastTimestamp' | tail -30 || true

      - name: Clean up kubeconfig
        if: always()
        run: |
          rm -f "$RUNNER_TEMP/kube/config"
